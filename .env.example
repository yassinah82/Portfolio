# ===================================================
# Vercel & Supabase Environment Variables
# Copy these to Vercel: Project Settings -> Environment Variables
# DO NOT COMMIT REAL SECRETS TO GIT
# ===================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon / public)
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Service Role Key (Server-side Secret)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role)
# CRITICAL: Keep this private. Only Vercel serverless functions will use this.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. Admin Dashboard Security Password
# Set a strong secret key for accessing /admin.html
ADMIN_PASSWORD=your-secure-admin-password

# 5. Discord Webhook (Optional)
# If provided, new contact form submissions will be forwarded to your Discord channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

